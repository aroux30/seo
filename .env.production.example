# =====================================================================
# AI SEO OS — Single VPS Production Environment Variables (.env.production)
# =====================================================================

# --- Domain (REQUIRED for SSL & Google OAuth) ---
DOMAIN=yourdomain.com

# --- PostgreSQL 16 ---
POSTGRES_USER=seo_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=ai_seo_os_db
DATABASE_URL=postgresql+asyncpg://seo_admin:CHANGE_ME_TO_STRONG_PASSWORD@postgres:5432/ai_seo_os_db

# --- Redis 7 ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Security (JWT + Encryption) ---
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_HEX
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# --- CORS ---
BACKEND_CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# --- API Prefix ---
API_V1_PREFIX=/api/v1

# --- AI Provider API Keys ---
OPENAI_API_KEY=sk-proj-YOUR_KEY
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY
GOOGLE_AI_API_KEY=YOUR_GEMINI_KEY
DEFAULT_AI_PROVIDER=openai

# --- Google OAuth (Search Console API) ---
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://seo.arouxpingg.com/api/v1/integrations/gsc/callback

# --- n8n Automation Engine ---
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_N8N_PASSWORD
N8N_WEBHOOK_BASE_URL=http://n8n:5678
# REQUIRED. The webhook callback endpoint fails closed: if this is empty every
# n8n callback is rejected with 401. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The same value must be set as the X-Webhook-Secret header in each n8n workflow.
N8N_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# --- Frontend ---
NEXT_PUBLIC_API_URL=/api/v1
