# AI SEO OS

# Database
POSTGRES_USER=seoos
POSTGRES_PASSWORD=seoos_dev_password_2026
POSTGRES_DB=seoos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://seoos:seoos_dev_password_2026@postgres:5432/seoos

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ENCRYPTION_KEY=change-me-generate-with-python-cryptography-fernet
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:3000
API_V1_PREFIX=/api/v1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google OAuth (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gsc/callback

# AI Providers (Phase 5+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEFAULT_AI_PROVIDER=openai
GOOGLE_PAGESPEED_API_KEY=

# n8n (Phase 7)
# Must match Settings.N8N_WEBHOOK_BASE_URL in app/config.py — a differently
# named variable is silently ignored and the default is used instead.
N8N_WEBHOOK_BASE_URL=http://n8n:5678
N8N_API_KEY=
# Shared secret n8n must send back as the X-Webhook-Secret header.
# The callback endpoint fails closed: leave this empty and every n8n
# callback is rejected with 401. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
N8N_WEBHOOK_SECRET=

# Notifications (Phase 7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@seoos.app
